generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MovementType {
  ENTRADA
  SAIDA
}

model User {
  id           Int         @id @default(autoincrement())
  email        String      @unique
  username     String
  passwordHash String
  tokens       AuthToken[]
}

model AuthToken {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String

  expiresAt DateTime
  createdAt DateTime @default(now())

  revoked Boolean @default(false)

  @@index([userId])
}

model Client {
  id    Int     @id @default(autoincrement())
  name  String
  email String  @unique
  phone String?

  loans Loan[]
}

model Item {
  id            Int             @id @default(autoincrement())
  name          String
  category      String?
  totalQuantity Int
  location      String
  loans         Loan[]
  movements     StockMovement[]
}

model Loan {
  id Int @id @default(autoincrement())

  loanDate     DateTime  @default(now())
  dueDate      DateTime
  returnDate   DateTime?
  loanQuantity Int       @default(1)

  client   Client @relation(fields: [clientId], references: [id])
  clientId Int

  item   Item @relation(fields: [itemId], references: [id])
  itemId Int

  movements StockMovement[]
}

model StockMovement {
  id        Int          @id @default(autoincrement())
  type      MovementType
  quantity  Int
  reason    String?
  createdAt DateTime     @default(now())

  itemId Int
  item   Item @relation(fields: [itemId], references: [id])

  loanId Int?
  loan   Loan? @relation(fields: [loanId], references: [id])
}
