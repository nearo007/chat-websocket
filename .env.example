# Server
PORT=3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_db"
DB_CONNECTION_TIMEOUT_MS=5000
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="app_db"

# JWT
JWT_SECRET="replace-with-at-least-32-random-characters-access"
JWT_SECRET_REFRESH="replace-with-at-least-32-random-characters-refresh"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_ISSUER="sistema-inventario-fablab"
JWT_AUDIENCE="sistema-inventario-fablab-api"

# HTTP
CORS_ORIGINS="http://localhost:5173"
JSON_BODY_LIMIT="100kb"
LOG_LEVEL="info"

# Required only by npm run db:bootstrap-admin
BOOTSTRAP_ADMIN_USERNAME="admin"
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-strong-admin-password"

# Required only by npm run db:seed
SEED_ADMIN_PASSWORD="replace-with-a-strong-admin-password"
SEED_OPERATOR_PASSWORD="replace-with-a-strong-operator-password"
