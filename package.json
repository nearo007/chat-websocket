{
    "name": "sistema-inventario-fablab",
    "version": "1.0.0",
    "description": "API de gerenciamento de inventário e empréstimos para FabLabs",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
        "prebuild": "npm run clean && prisma generate",
        "build": "tsc && tsc-alias",
        "start": "node dist/server.js",
        "start:db": "docker compose up -d --wait postgres && npm run db:generate && npm run db:deploy && npm run dev",
        "typecheck": "prisma generate && tsc --noEmit && tsc -p tsconfig.seed.json && tsc -p tsconfig.test.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "lint": "biome check src seed tests vitest.config.ts",
        "format": "biome format --write src seed tests vitest.config.ts",
        "docs:lint": "redocly lint openapi.yaml",
        "check": "npm run lint && npm run docs:lint && npm run typecheck && npm run test && npm run build",
        "db:migrate": "prisma migrate dev",
        "db:deploy": "prisma migrate deploy",
        "db:push": "prisma db push",
        "db:reset": "prisma migrate reset",
        "db:generate": "prisma generate",
        "db:studio": "prisma studio",
        "db:bootstrap-admin": "tsx seed/admin.ts",
        "db:seed": "tsx seed/index.ts"
    },
    "prisma": {
        "seed": "tsx seed/index.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "@prisma/adapter-pg": "^7.10.0",
        "@prisma/client": "^7.10.0",
        "bcrypt": "^6.0.0",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.7.0",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "ms": "^2.1.3",
        "pg": "^8.20.0",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.12",
        "@redocly/cli": "^2.51.2",
        "@types/bcrypt": "^6.0.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/ms": "^2.1.0",
        "@types/node": "^25.5.2",
        "@types/pg": "^8.20.0",
        "@types/supertest": "^7.2.1",
        "@vitest/coverage-v8": "^5.0.0",
        "prisma": "^7.10.0",
        "supertest": "^7.2.2",
        "tsc-alias": "^1.9.4",
        "tsx": "^4.21.0",
        "typescript": "^6.0.2",
        "vitest": "^5.0.0"
    },
    "engines": {
        "node": "^20.19 || ^22.12 || >=24.0"
    },
    "overrides": {
        "deepmerge-ts": "^8.0.2",
        "mysql2": "^3.24.3"
    }
}
